# ==============================================================================
# ChessMind AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vite / React) Environment Variables
# In production on Vercel: set these in Project Settings -> Environment Variables.
# In local development: copy to frontend/.env or frontend/.env.local
# ------------------------------------------------------------------------------
# REST API URL of the FastAPI backend
VITE_API_URL=http://localhost:8000

# WebSocket URL for online 1v1 real-time gameplay
# (Use ws:// for localhost, wss:// for production HTTPS domains)
VITE_WS_URL=ws://localhost:8000

# Supabase Public Credentials (safe for browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# Backend (FastAPI / Render) Environment Variables (Optional)
# In production on Render: set these in Dashboard -> Environment.
# Required only if executing administrative or background database tasks from Python.
# Backend (FastAPI / Render / Fly.io) Environment Variables
# In production: set in your platform dashboard -> Environment Variables.
# In local development: copy to .env in project root
# ------------------------------------------------------------------------------
PORT=8000

# Supabase Backend Configuration
SUPABASE_URL=https://your-project-id.supabase.co
# Keep service_role secret strictly on backend server only - NEVER expose in frontend!

# Private Service Role Key - STRICTLY PRIVATE TO BACKEND SERVER ONLY!
# NEVER put this in frontend code, Vercel frontend envs, or commit to Git.
# Used by the backend to authoritative persist match results, ratings, and moves.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
PORT=8000
