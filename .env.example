# ==============================================================================
# ChessMind AI - Environment Configuration Example
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend (Vite / React) Environment Variables
# In production on Vercel: set these in Project Settings -> Environment Variables.
# In local development: copy to frontend/.env or frontend/.env.local
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ------------------------------------------------------------------------------
# Backend (FastAPI / Render) Environment Variables (Optional)
# In production on Render: set these in Dashboard -> Environment.
# Required only if executing administrative or background database tasks from Python.
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Keep service_role secret strictly on backend server only - NEVER expose in frontend!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
PORT=8000
